{
  "name": "retro-action-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "depcruise": "depcruise packages apps packs infra --config .dependency-cruiser.cjs",
    "build": "pnpm -r --if-present run build",
    "golden:update": "pnpm -r --if-present run golden:update",
    "e2e": "pnpm -r --if-present run e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.5.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
